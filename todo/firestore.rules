rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Görev doğrulaması: zorunlu alanlar ve makul boyutlar
    function validTask(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 500
        && d.done is bool
        && d.priority is int && d.priority >= 0 && d.priority <= 3
        && (!('note' in d) || (d.note is string && d.note.size() <= 10000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('subtasks' in d) || (d.subtasks is list && d.subtasks.size() <= 100));
    }

    function validList(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100;
    }

    // Her kullanıcı yalnızca kendi verisine erişir
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask(request.resource.data);
      }

      match /lists/{listId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validList(request.resource.data);
      }
    }

    // Geri kalan her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
