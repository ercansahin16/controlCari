rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Giriş yok: todo/ yolu oturum gerektirmeden açık (doğrulama kuralları var).
    function signedIn() { return true; }

    function validTask(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 500
        && d.done is bool
        && d.priority is int && d.priority >= 0 && d.priority <= 3
        && (!('note' in d) || (d.note is string && d.note.size() <= 10000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 20))
        && (!('subtasks' in d) || (d.subtasks is list && d.subtasks.size() <= 100));
    }

    function validList(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100;
    }

    match /todo/{owner} {
      match /tasks/{taskId} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn() && validTask(request.resource.data);
      }
      match /lists/{listId} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn() && validList(request.resource.data);
      }
    }

    // NOT: muhtelif123 projesindeki diğer uygulamaların kuralları da
    // buraya eklenmeli, yoksa aşağıdaki satır onları kapatır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
